{
  "name": "retirement-life-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix apps/current run dev",
    "dev:current": "npm --prefix apps/current run dev",
    "dev:next-tax-social": "npm --prefix apps/next-tax-social run dev",
    "dev:time-bucket": "npm --prefix apps/time-bucket-planner run dev",
    "serve:local": "bash scripts/ensure-local-server.sh current",
    "serve:current": "bash scripts/ensure-local-server.sh current",
    "serve:next-tax-social": "PORT=5175 bash scripts/ensure-local-server.sh next-tax-social",
    "build": "npm --prefix apps/current run build",
    "build:current": "npm --prefix apps/current run build",
    "build:next-tax-social": "npm --prefix apps/next-tax-social run build",
    "build:time-bucket": "npm --prefix apps/time-bucket-planner run build",
    "preview": "npm --prefix apps/current run preview",
    "test": "npm --prefix apps/current run test",
    "test:current": "npm --prefix apps/current run test",
    "test:next-tax-social": "npm --prefix apps/next-tax-social run test",
    "test:watch": "npm --prefix apps/current run test:watch"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "lucide-react": "^0.561.0",
    "recharts": "^3.5.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^7.3.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "jsdom": "^27.3.0",
    "postcss": "^8.5.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
